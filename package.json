{
  "name": "sofra-restaurant",
  "version": "1.0.0",
  "private": true,
  "description": "Sofra Restaurant - Full-Stack Practicum Application",
  "scripts": {
    "install:all": "npm --prefix client install && npm --prefix server install",
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:preview": "npm --prefix client run preview",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server run start",
    "server:seed": "npm --prefix server run seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
